@model software_elviejomadero.ViewModels.ReceptionOrderIndexViewModel

@{
    ViewData["Title"] = "Pedidos de recepción";
}

<!-- Leaflet CSS para el mapa interactivo de Delivery -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<div class="vm-admin-wrapper">
    <!-- Encabezado de Pedidos de Recepción -->
    <div class="vm-admin-header">
        <div>
            <h1 class="vm-page-title">Pedidos de recepción</h1>
            <p class="vm-page-subtitle">Registra pedidos de delivery o para llevar desde el local.</p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="vm-btn-outline-action" onclick="openOrderWizard('Para llevar')">
                <i class="bi bi-bag-check me-1"></i> Pedido para llevar
            </button>
            <button type="button" class="vm-btn-primary" onclick="openOrderWizard('Delivery')">
                <i class="bi bi-plus-lg me-1"></i> Registrar un pedido
            </button>
        </div>
    </div>

    <!-- Listado de Pedidos Registrados -->
    @if (!Model.Orders.Any())
    {
        <div class="vm-empty-box">
            No hay pedidos registrados en recepción todavía. Usa los botones superiores para registrar un pedido de delivery o para llevar.
        </div>
    }
    else
    {
        <div class="vm-orders-grid">
            @foreach (var order in Model.Orders)
            {
                bool isDelivery = order.OrderType == "Delivery";
                <div class="vm-order-card">
                    <div class="vm-order-card-top">
                        <span class="vm-order-code">@order.OrderCode</span>
                        <div class="vm-order-badges">
                            <span class="vm-badge-type @(isDelivery ? "vm-badge-delivery" : "vm-badge-takeout")">
                                @order.OrderType
                            </span>
                            <span class="vm-badge-status">@order.Status</span>
                        </div>
                    </div>

                    <div class="vm-order-customer">@order.CustomerName</div>

                    <div class="vm-order-meta">
                        @if (isDelivery)
                        {
                            <i class="bi bi-geo-alt me-1"></i>
                            <span>@order.DisplayAddress</span>
                        }
                        else
                        {
                            <i class="bi bi-shop me-1"></i>
                            <span>Cliente en local &middot; Para llevar</span>
                        }
                    </div>

                    <div class="vm-order-meta">
                        @order.TotalItemsCount @(order.TotalItemsCount == 1 ? "ítem" : "ítems") &middot; @order.PaymentMethod
                    </div>

                    <div class="vm-order-card-footer">
                        <span class="vm-order-total-label">Total</span>
                        <strong class="vm-order-total-value">S/ @order.TotalAmount.ToString("F2")</strong>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Ventana Emergente (Asistente de 4 Pasos): Registrar pedido de Delivery / Para llevar -->
<div class="modal fade" id="orderWizardModal" tabindex="-1" aria-labelledby="wizardModalTitle" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered vm-modal-dialog" id="wizardModalDialog">
        <div class="modal-content vm-modal-card">
            <div class="vm-modal-header border-bottom-0 pb-2">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <h5 class="vm-modal-title" id="wizardModalTitle">Registrar pedido de delivery</h5>
                        <div class="vm-wizard-step-label" id="wizardModalStepText">Paso 1 de 4</div>
                    </div>
                    <button type="button" class="btn-close btn-sm mt-1" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <!-- Barra de progreso de 4 pasos -->
                <div class="vm-wizard-progress mt-3">
                    <div class="vm-wizard-bar active" id="stepBar1"></div>
                    <div class="vm-wizard-bar" id="stepBar2"></div>
                    <div class="vm-wizard-bar" id="stepBar3"></div>
                    <div class="vm-wizard-bar" id="stepBar4"></div>
                </div>
            </div>

            <form asp-controller="ReceptionOrder" asp-action="Create" method="post" id="receptionOrderForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" name="OrderType" id="inputOrderType" value="Delivery" />
                <input type="hidden" name="Latitude" id="inputLatitude" value="" />
                <input type="hidden" name="Longitude" id="inputLongitude" value="" />
                <input type="hidden" name="PaymentMethod" id="inputPaymentMethod" value="Yape" />
                <div id="hiddenOrderItemsInputs"></div>

                <div class="vm-modal-body pt-2">
                    <!-- Alerta de validación dinámica entre pasos -->
                    <div id="wizardValidationAlert" class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-none"></div>

                    <!-- ==================== PASO 1 DE 4: DATOS DEL CLIENTE ==================== -->
                    <div id="wizardStep1" class="vm-wizard-step">
                        <div class="vm-field-group">
                            <label class="vm-modal-label" for="inputCustomerName">
                                <i class="bi bi-person me-1"></i> Nombre del cliente
                            </label>
                            <input type="text" id="inputCustomerName" name="CustomerName" class="vm-modal-input" maxlength="120" placeholder="Ej: Maria Gomez" />
                        </div>

                        <div class="vm-field-group">
                            <label class="vm-modal-label" for="inputCustomerPhone">
                                <i class="bi bi-telephone me-1"></i> Teléfono
                            </label>
                            <input type="text" id="inputCustomerPhone" name="CustomerPhone" class="vm-modal-input" maxlength="9" placeholder="Ej: 947832487" />
                        </div>

                        <!-- Campos exclusivos de Delivery -->
                        <div id="deliveryOnlySection">
                            <div class="vm-field-group">
                                <label class="vm-modal-label" for="inputDeliveryAddress">
                                    <i class="bi bi-geo-alt me-1"></i> Dirección de entrega
                                </label>
                                <input type="text" id="inputDeliveryAddress" name="DeliveryAddress" class="vm-modal-input" maxlength="250" placeholder="Ej: Av. Javier Prado 1256" />
                            </div>

                            <div class="vm-field-group mb-1">
                                <label class="vm-modal-label">Ubicación en el mapa</label>
                                <div id="deliveryLeafletMap" class="vm-leaflet-map"></div>
                                <div id="mapHelperText" class="vm-map-helper">
                                    Toca el mapa para colocar el pin donde vive el cliente.
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ==================== PASO 2 DE 4: CARTA Y PANEL PEDIDO ==================== -->
                    <div id="wizardStep2" class="vm-wizard-step d-none">
                        <div class="vm-step2-layout">
                            <!-- Columna Izquierda: Carta de platos -->
                            <div class="vm-step2-catalog">
                                @foreach (var group in Model.AvailableCategoryGroups)
                                {
                                    <div class="vm-step2-cat-block">
                                        <h6 class="vm-step2-cat-title">@group.CategoryName</h6>
                                        <div class="vm-step2-dish-list">
                                            @foreach (var dish in group.Dishes)
                                            {
                                                <div class="vm-step2-dish-item"
                                                     onclick="addDishToCart(@dish.Id, '@Html.Raw(dish.Name.Replace("'", "\\'"))', @dish.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))">
                                                    <div class="vm-step2-dish-info">
                                                        <div class="vm-step2-dish-name">@dish.Name</div>
                                                        <div class="vm-step2-dish-desc">@dish.Description</div>
                                                    </div>
                                                    <div class="vm-step2-dish-right">
                                                        <span class="vm-step2-dish-price">S/ @dish.Price.ToString("F2")</span>
                                                        <span class="vm-step2-dish-indicator" id="catalogBadge-@dish.Id">+</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>

                            <!-- Columna Derecha: Panel "Pedido" -->
                            <div class="vm-step2-cart">
                                <div class="vm-step2-cart-title">Pedido</div>
                                <div id="cartItemsList" class="vm-step2-cart-items">
                                    <!-- Renderizado dinámicamente por JS -->
                                </div>
                                <div class="vm-step2-cart-footer">
                                    <span>Total</span>
                                    <strong id="step2TotalDisplay">S/ 0.00</strong>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ==================== PASO 3 DE 4: MÉTODO DE PAGO Y NOTA ==================== -->
                    <div id="wizardStep3" class="vm-wizard-step d-none">
                        <p class="vm-step3-prompt">Selecciona el método de pago del cliente.</p>

                        <div class="vm-payment-grid">
                            <button type="button" class="vm-payment-option active" data-payment="Yape" onclick="selectPaymentMethod('Yape')">
                                Yape
                            </button>
                            <button type="button" class="vm-payment-option" data-payment="Plin" onclick="selectPaymentMethod('Plin')">
                                Plin
                            </button>
                            <button type="button" class="vm-payment-option" data-payment="Efectivo" onclick="selectPaymentMethod('Efectivo')">
                                Efectivo
                            </button>
                        </div>

                        <div class="vm-field-group mb-0">
                            <label class="vm-modal-label" for="inputAdditionalNote">Nota adicional (opcional)</label>
                            <textarea id="inputAdditionalNote" name="AdditionalNote" rows="3" class="vm-modal-textarea" maxlength="500" placeholder="Ej: Sin ají, todas las cremas..."></textarea>
                        </div>
                    </div>

                    <!-- ==================== PASO 4 DE 4: RESUMEN DEL PEDIDO ==================== -->
                    <div id="wizardStep4" class="vm-wizard-step d-none">
                        <!-- Caja 1: Datos del cliente -->
                        <div class="vm-summary-card mb-3">
                            <div class="vm-summary-heading">DATOS DEL CLIENTE</div>
                            <div class="vm-summary-client-name" id="summaryCustomerName"></div>
                            <div class="vm-summary-meta" id="summaryCustomerPhone"></div>
                            <div class="vm-summary-meta" id="summaryCustomerAddress"></div>
                            <div class="vm-summary-payment" id="summaryPaymentMethod"></div>
                            <div class="vm-summary-meta mt-1 fst-italic d-none" id="summaryAdditionalNote"></div>
                        </div>

                        <!-- Caja 2: Detalle del pedido -->
                        <div class="vm-summary-card">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="vm-summary-heading mb-0">DETALLE DEL PEDIDO</span>
                                <button type="button" class="vm-summary-edit-link" onclick="goToWizardStep(2)">Editar</button>
                            </div>

                            <div id="summaryItemsContainer" class="vm-summary-items"></div>

                            <div class="vm-summary-total-row">
                                <span>Total</span>
                                <strong id="summaryTotalDisplay">S/ 0.00</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Pie del Modal con Navegación entre Pasos -->
                <div class="vm-modal-footer justify-content-between" id="wizardModalFooter">
                    <div>
                        <button type="button" class="vm-btn-cancel d-none" id="btnWizardBack" onclick="prevWizardStep()">
                            <i class="bi bi-arrow-left me-1"></i> Atrás
                        </button>
                    </div>
                    <div>
                        <button type="button" class="vm-btn-save" id="btnWizardNext" onclick="nextWizardStep()">
                            Siguiente <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                        <button type="submit" class="vm-btn-save d-none" id="btnWizardSubmit">
                            <i class="bi bi-check2 me-1"></i> Enviar a cocina
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

    <script>
        let currentStep = 1;
        let currentOrderType = 'Delivery';
        let cart = []; // [{ dishId, name, price, quantity }]
        let leafletMap = null;
        let deliveryMarker = null;

        // Coordenadas iniciales en Lima (Av. Javier Prado / San Isidro - La Molina)
        const defaultLat = -12.0864;
        const defaultLng = -77.0015;

        function openOrderWizard(orderType) {
            currentOrderType = orderType;
            currentStep = 1;
            cart = [];

            // Reiniciar campos del formulario
            document.getElementById('receptionOrderForm').reset();
            document.getElementById('inputOrderType').value = orderType;
            document.getElementById('inputLatitude').value = '';
            document.getElementById('inputLongitude').value = '';
            selectPaymentMethod('Yape');

            // Configurar textos según tipo de pedido
            const titleEl = document.getElementById('wizardModalTitle');
            const deliverySection = document.getElementById('deliveryOnlySection');

            if (orderType === 'Delivery') {
                titleEl.textContent = 'Registrar pedido de delivery';
                deliverySection.classList.remove('d-none');
            } else {
                titleEl.textContent = 'Registrar pedido para llevar';
                deliverySection.classList.add('d-none');
            }

            // Reiniciar indicadores del catálogo
            document.querySelectorAll('.vm-step2-dish-indicator').forEach(el => {
                el.textContent = '+';
                el.classList.remove('has-qty');
            });
            renderCartPanel();
            hideValidationError();
            updateWizardUI();

            const modalEl = document.getElementById('orderWizardModal');
            const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);
            modalInstance.show();

            if (orderType === 'Delivery') {
                setTimeout(() => {
                    initOrRefreshMap();
                }, 260);
            }
        }

        function initOrRefreshMap() {
            if (!leafletMap) {
                leafletMap = L.map('deliveryLeafletMap').setView([defaultLat, defaultLng], 15);
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                }).addTo(leafletMap);

                leafletMap.on('click', function (e) {
                    setDeliveryPin(e.latlng.lat, e.latlng.lng);
                });
            } else {
                leafletMap.invalidateSize();
                leafletMap.setView([defaultLat, defaultLng], 15);
            }

            if (deliveryMarker) {
                leafletMap.removeLayer(deliveryMarker);
                deliveryMarker = null;
            }
            document.getElementById('mapHelperText').textContent = 'Toca el mapa para colocar el pin donde vive el cliente.';
        }

        function setDeliveryPin(lat, lng) {
            document.getElementById('inputLatitude').value = lat.toFixed(6);
            document.getElementById('inputLongitude').value = lng.toFixed(6);

            const pinIcon = L.divIcon({
                className: 'vm-custom-map-pin',
                html: '<div class="vm-pin-dot"><i class="bi bi-geo-alt-fill"></i></div>',
                iconSize: [30, 30],
                iconAnchor: [15, 28]
            });

            if (!deliveryMarker) {
                deliveryMarker = L.marker([lat, lng], { icon: pinIcon, draggable: true }).addTo(leafletMap);
                deliveryMarker.on('dragend', function (ev) {
                    const pos = ev.target.getLatLng();
                    document.getElementById('inputLatitude').value = pos.lat.toFixed(6);
                    document.getElementById('inputLongitude').value = pos.lng.toFixed(6);
                });
            } else {
                deliveryMarker.setLatLng([lat, lng]);
            }

            document.getElementById('mapHelperText').textContent = 'Toca el mapa para mover el pin de entrega.';
            hideValidationError();
        }

        function addDishToCart(dishId, name, price) {
            const existing = cart.find(i => i.dishId === dishId);
            if (existing) {
                existing.quantity += 1;
            } else {
                cart.push({ dishId, name, price: parseFloat(price), quantity: 1 });
            }
            updateCatalogBadge(dishId);
            renderCartPanel();
            hideValidationError();
        }

        function changeCartQty(dishId, delta) {
            const idx = cart.findIndex(i => i.dishId === dishId);
            if (idx === -1) return;

            cart[idx].quantity += delta;
            if (cart[idx].quantity <= 0) {
                cart.splice(idx, 1);
            }
            updateCatalogBadge(dishId);
            renderCartPanel();
        }

        function removeCartDish(dishId) {
            cart = cart.filter(i => i.dishId !== dishId);
            updateCatalogBadge(dishId);
            renderCartPanel();
        }

        function updateCatalogBadge(dishId) {
            const badge = document.getElementById(`catalogBadge-${dishId}`);
            if (!badge) return;
            const item = cart.find(i => i.dishId === dishId);
            if (item && item.quantity > 0) {
                badge.textContent = item.quantity;
                badge.classList.add('has-qty');
            } else {
                badge.textContent = '+';
                badge.classList.remove('has-qty');
            }
        }

        function renderCartPanel() {
            const container = document.getElementById('cartItemsList');
            const totalDisplay = document.getElementById('step2TotalDisplay');

            if (cart.length === 0) {
                container.innerHTML = '<div class="vm-cart-empty">Selecciona platos de la carta para agregarlos al pedido.</div>';
                totalDisplay.textContent = 'S/ 0.00';
                return;
            }

            let html = '';
            let total = 0;

            cart.forEach(item => {
                const sub = item.price * item.quantity;
                total += sub;
                html += `
                    <div class="vm-cart-row">
                        <div class="vm-cart-row-info">
                            <div class="vm-cart-row-name">${item.name}</div>
                            <div class="vm-cart-row-unit">S/ ${item.price.toFixed(2)} c/u</div>
                        </div>
                        <div class="vm-cart-row-controls">
                            <button type="button" class="vm-qty-btn" onclick="changeCartQty(${item.dishId}, -1)" title="Disminuir">&minus;</button>
                            <span class="vm-qty-val">${item.quantity}</span>
                            <button type="button" class="vm-qty-btn" onclick="changeCartQty(${item.dishId}, 1)" title="Aumentar">+</button>
                            <button type="button" class="vm-qty-del" onclick="removeCartDish(${item.dishId})" title="Eliminar">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
            totalDisplay.textContent = `S/${total.toFixed(2)}`;
        }

        function selectPaymentMethod(method) {
            document.getElementById('inputPaymentMethod').value = method;
            document.querySelectorAll('.vm-payment-option').forEach(btn => {
                btn.classList.toggle('active', btn.getAttribute('data-payment') === method);
            });
        }

        function validateCurrentStep() {
            if (currentStep === 1) {
                const name = document.getElementById('inputCustomerName').value.trim();
                const phone = document.getElementById('inputCustomerPhone').value.trim();

                if (!name) {
                    showValidationError('Por favor, ingresa el nombre del cliente.');
                    return false;
                }
                if (!/^\d{7,15}$/.test(phone)) {
                    showValidationError('Por favor, ingresa un número de teléfono válido.');
                    return false;
                }

                if (currentOrderType === 'Delivery') {
                    const address = document.getElementById('inputDeliveryAddress').value.trim();
                    const lat = document.getElementById('inputLatitude').value;
                    const lng = document.getElementById('inputLongitude').value;

                    if (!address) {
                        showValidationError('El pedido de delivery requiere ingresar la dirección de entrega.');
                        return false;
                    }
                    if (!lat || !lng) {
                        showValidationError('Por favor, ubica el pin de entrega en el mapa antes de continuar.');
                        return false;
                    }
                }
            } else if (currentStep === 2) {
                if (cart.length === 0) {
                    showValidationError('Un pedido debe tener al menos un plato para poder enviarse a cocina.');
                    return false;
                }
            } else if (currentStep === 3) {
                const payment = document.getElementById('inputPaymentMethod').value;
                if (!payment) {
                    showValidationError('Selecciona el método de pago del cliente.');
                    return false;
                }
            }

            hideValidationError();
            return true;
        }

        function nextWizardStep() {
            if (!validateCurrentStep()) return;

            if (currentStep < 4) {
                currentStep += 1;
                if (currentStep === 4) {
                    populateStep4Summary();
                }
                updateWizardUI();
            }
        }

        function prevWizardStep() {
            hideValidationError();
            if (currentStep > 1) {
                currentStep -= 1;
                updateWizardUI();
                if (currentStep === 1 && currentOrderType === 'Delivery' && leafletMap) {
                    setTimeout(() => leafletMap.invalidateSize(), 150);
                }
            }
        }

        function goToWizardStep(stepNumber) {
            hideValidationError();
            currentStep = stepNumber;
            updateWizardUI();
        }

        function populateStep4Summary() {
            const name = document.getElementById('inputCustomerName').value.trim();
            const phone = document.getElementById('inputCustomerPhone').value.trim();
            const address = document.getElementById('inputDeliveryAddress').value.trim();
            const payment = document.getElementById('inputPaymentMethod').value;
            const note = document.getElementById('inputAdditionalNote').value.trim();

            document.getElementById('summaryCustomerName').textContent = name;
            document.getElementById('summaryCustomerPhone').textContent = `Tel: ${phone}`;
            document.getElementById('summaryCustomerAddress').textContent =
                currentOrderType === 'Delivery' ? address : 'Cliente en local · Pedido para llevar';
            document.getElementById('summaryPaymentMethod').textContent = `Pago: ${payment}`;

            const noteEl = document.getElementById('summaryAdditionalNote');
            if (note) {
                noteEl.textContent = `Nota: ${note}`;
                noteEl.classList.remove('d-none');
            } else {
                noteEl.textContent = '';
                noteEl.classList.add('d-none');
            }

            let itemsHtml = '';
            let hiddenInputsHtml = '';
            let total = 0;

            cart.forEach((item, index) => {
                const sub = item.price * item.quantity;
                total += sub;
                itemsHtml += `
                    <div class="vm-summary-item-row">
                        <span>${item.quantity}&times; ${item.name}</span>
                        <span class="vm-summary-item-price">S/ ${sub.toFixed(2)}</span>
                    </div>
                `;
                hiddenInputsHtml += `
                    <input type="hidden" name="Items[${index}].DishId" value="${item.dishId}" />
                    <input type="hidden" name="Items[${index}].Quantity" value="${item.quantity}" />
                `;
            });

            document.getElementById('summaryItemsContainer').innerHTML = itemsHtml;
            document.getElementById('summaryTotalDisplay').textContent = `S/ ${total.toFixed(2)}`;
            document.getElementById('hiddenOrderItemsInputs').innerHTML = hiddenInputsHtml;
        }

        function updateWizardUI() {
            document.getElementById('wizardModalStepText').textContent = `Paso ${currentStep} de 4`;

            // Actualizar barras de progreso
            for (let i = 1; i <= 4; i++) {
                const bar = document.getElementById(`stepBar${i}`);
                bar.classList.toggle('active', i <= currentStep);
            }

            // Mostrar/ocultar contenedores de cada paso
            for (let i = 1; i <= 4; i++) {
                const stepDiv = document.getElementById(`wizardStep${i}`);
                stepDiv.classList.toggle('d-none', i !== currentStep);
            }

            // Ajustar ancho del modal en el Paso 2 (vista de 2 columnas)
            const dialog = document.getElementById('wizardModalDialog');
            dialog.classList.toggle('vm-modal-dialog-wide', currentStep === 2);

            // Mostrar/ocultar botones del pie
            document.getElementById('btnWizardBack').classList.toggle('d-none', currentStep === 1);
            document.getElementById('btnWizardNext').classList.toggle('d-none', currentStep === 4);
            document.getElementById('btnWizardSubmit').classList.toggle('d-none', currentStep !== 4);
        }

        function showValidationError(msg) {
            const box = document.getElementById('wizardValidationAlert');
            box.textContent = msg;
            box.classList.remove('d-none');
        }

        function hideValidationError() {
            const box = document.getElementById('wizardValidationAlert');
            box.textContent = '';
            box.classList.add('d-none');
        }
    </script>
}
