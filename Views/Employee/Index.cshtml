@model software_elviejomadero.ViewModels.EmployeeListViewModel
@using System.Security.Claims
@{
    ViewData["Title"] = "Gestión de Empleados";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<!-- Encabezado de Administración y Pestañas Segmentadas -->
<div class="vm-admin-header">
    <div>
        <h1 class="vm-page-title">Administración</h1>
        <p class="vm-page-subtitle">Operación, carta, empleados y resultados de El Viejo Madero.</p>
    </div>

    <div class="vm-segmented-tabs">
        <a class="vm-seg-tab" asp-controller="Administration" asp-action="Index">Panel</a>
        <a class="vm-seg-tab" asp-controller="Dish" asp-action="Index">Carta</a>
        <a class="vm-seg-tab active" asp-controller="Employee" asp-action="Index">Empleados</a>
        <a class="vm-seg-tab" asp-controller="Administration" asp-action="Reports">Reportes</a>
    </div>
</div>

<!-- Sección: Gestión de empleados -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
    <div class="card-header bg-white border-bottom p-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h2 class="h5 fw-bold text-madero-dark font-serif mb-1">Gestión de empleados</h2>
            <div class="text-muted small">
                <span class="fw-semibold text-madero" id="totalEmployeesCount">@Model.TotalCount</span> colaboradores registrados
            </div>
        </div>

        <!-- Filtro por Rol y Botón Nuevo Empleado -->
        <div class="d-flex flex-wrap align-items-center gap-2">
            <form method="get" asp-action="Index" class="d-flex align-items-center">
                <select name="role" id="roleFilterSelect" class="form-select form-select-sm rounded-pill pe-4" onchange="this.form.submit()">
                    <option value="">Todos los roles</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role" selected="@(Model.SelectedRole == role)">@role</option>
                    }
                </select>
            </form>
            <button type="button" class="vm-btn-primary" data-bs-toggle="modal" data-bs-target="#newEmployeeModal">
                <i class="bi bi-plus-lg me-1"></i> Nuevo empleado
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 custom-table">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-4 py-3">Empleado</th>
                    <th class="py-3">Contacto</th>
                    <th class="py-3">Usuario</th>
                    <th class="py-3">Rol</th>
                    <th class="py-3 text-center">Estado</th>
                    <th class="pe-4 py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Employees.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-6 d-block mb-2 text-muted-50"></i>
                            No se encontraron empleados registrados con el filtro seleccionado.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model.Employees)
                    {
                        var isSelf = emp.Id == currentUserId;
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle-sm bg-madero-soft text-madero fw-bold">
                                        @emp.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-madero-dark">
                                            @emp.FullName
                                            @if (isSelf)
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary ms-1 small">Tú</span>
                                            }
                                        </div>
                                        <div class="text-muted small">Registrado: @emp.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small">
                                    <div><i class="bi bi-card-heading me-1 text-muted"></i> DNI: <strong>@emp.DNI</strong></div>
                                    <div><i class="bi bi-telephone me-1 text-muted"></i> @emp.Phone</div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1 font-monospace">
                                    @@@emp.UserName
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-3 py-1 @(emp.Role == "Administrador" ? "bg-danger-subtle text-danger border border-danger-subtle" :
                                                                          emp.Role == "Mozo" ? "bg-primary-subtle text-primary border border-primary-subtle" :
                                                                          emp.Role == "Cocinero" ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" :
                                                                          emp.Role == "Recepcionista" ? "bg-info-subtle text-info-emphasis border border-info-subtle" :
                                                                          "bg-secondary-subtle text-secondary border border-secondary-subtle")">
                                    @emp.Role
                                </span>
                            </td>
                            <td class="text-center">
                                @if (emp.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-slash-circle me-1"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <!-- Botón Editar (CA-01) -->
                                    <button type="button" class="btn btn-sm btn-light border-0 rounded-circle text-primary" 
                                            title="Editar empleado"
                                            onclick="openEditModal('@emp.Id')">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <!-- Botón Activar / Desactivar (CA-04) -->
                                    @if (isSelf)
                                    {
                                        <button type="button" class="btn btn-sm btn-light border-0 rounded-circle text-muted" 
                                                title="No puedes desactivarte a ti mismo" disabled>
                                            <i class="bi bi-toggle-on text-muted opacity-50"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleStatus" asp-route-id="@emp.Id" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-light border-0 rounded-circle @(emp.IsActive ? "text-warning" : "text-success")" 
                                                    title="@(emp.IsActive ? "Desactivar empleado" : "Activar empleado")">
                                                <i class="bi @(emp.IsActive ? "bi-slash-circle" : "bi-check-circle")"></i>
                                            </button>
                                        </form>
                                    }

                                    <!-- Botón Eliminar (CA-05) -->
                                    @if (isSelf)
                                    {
                                        <button type="button" class="btn btn-sm btn-light border-0 rounded-circle text-muted" 
                                                title="No puedes eliminarte a ti mismo" disabled>
                                            <i class="bi bi-trash text-muted opacity-50"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-light border-0 rounded-circle text-danger" 
                                                title="Eliminar empleado"
                                                onclick="openDeleteModal('@emp.Id', '@emp.FullName.Replace("'", "\\'")')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Nuevo Empleado (HU-17) -->
<div class="modal fade" id="newEmployeeModal" tabindex="-1" aria-labelledby="newEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-madero-dark font-serif" id="newEmployeeModalLabel">Nuevo empleado</h5>
                    <p class="text-muted small mb-0">Registra un nuevo colaborador con su rol y credenciales de acceso.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form asp-controller="Employee" asp-action="Create" method="post" id="createEmployeeForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label asp-for="NewEmployee.FullName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="NewEmployee.FullName" name="FullName" class="form-control" id="fullNameInput" placeholder="Ej: Juan Pérez García" required />
                        <span asp-validation-for="NewEmployee.FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="NewEmployee.DNI" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="NewEmployee.DNI" name="DNI" class="form-control" maxlength="8" placeholder="8 dígitos" required />
                            <span asp-validation-for="NewEmployee.DNI" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="NewEmployee.Phone" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="NewEmployee.Phone" name="Phone" class="form-control" maxlength="9" placeholder="9 dígitos" required />
                            <span asp-validation-for="NewEmployee.Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewEmployee.UserName" class="form-label small fw-semibold text-secondary">
                            Nombre de usuario <span class="badge bg-light text-muted border ms-1">Generado automáticamente</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">@@</span>
                            <input asp-for="NewEmployee.UserName" name="UserName" class="form-control bg-light font-monospace" id="generatedUserNameInput" readonly placeholder="Se autogenera al ingresar el nombre" />
                        </div>
                        <div class="form-text small text-muted">Formato: primera letra del nombre + primer apellido (ej: jperez).</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewEmployee.Role" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="NewEmployee.Role" name="Role" class="form-select" required>
                            <option value="">Seleccione un rol...</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span asp-validation-for="NewEmployee.Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewEmployee.InitialPassword" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <input asp-for="NewEmployee.InitialPassword" name="InitialPassword" type="password" class="form-control" id="initialPassInput" placeholder="••••••••" required />
                            <button class="btn btn-outline-secondary" type="button" id="toggleEmpPassBtn">
                                <i class="bi bi-eye" id="empPassIcon"></i>
                            </button>
                        </div>
                        <div class="form-text small text-muted">Mínimo 6 caracteres. Compartir de manera segura con el colaborador.</div>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input asp-for="NewEmployee.IsActive" name="IsActive" value="true" class="form-check-input" type="checkbox" id="employeeActiveSwitch" checked />
                        <label class="form-check-label small fw-medium text-secondary" for="employeeActiveSwitch">
                            Empleado activo (habilitado para iniciar sesión)
                        </label>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal" id="cancelEmployeeBtn">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-madero rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Guardar empleado
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Editar Empleado (HU-18 CA-01) -->
<div class="modal fade" id="editEmployeeModal" tabindex="-1" aria-labelledby="editEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-madero-dark font-serif" id="editEmployeeModalLabel">Editar empleado</h5>
                    <p class="text-muted small mb-0">Actualiza los datos, rol o credenciales del colaborador.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form asp-controller="Employee" asp-action="Edit" method="post" id="editEmployeeForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editId" name="Id" value="" />

                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Nombre completo</label>
                        <input name="FullName" id="editFullName" class="form-control" placeholder="Ej: Juan Pérez García" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">DNI</label>
                            <input name="DNI" id="editDNI" class="form-control" maxlength="8" placeholder="8 dígitos" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold text-secondary">Teléfono</label>
                            <input name="Phone" id="editPhone" class="form-control" maxlength="9" placeholder="9 dígitos" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Nombre de usuario</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">@@</span>
                            <input id="editUserName" class="form-control bg-light font-monospace" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Rol</label>
                        <select name="Role" id="editRole" class="form-select" required>
                            <option value="">Seleccione un rol...</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Nueva contraseña (opcional)</label>
                        <div class="input-group">
                            <input name="NewPassword" type="password" class="form-control" id="editPassInput" placeholder="Dejar en blanco para mantener la actual" />
                            <button class="btn btn-outline-secondary" type="button" id="toggleEditPassBtn">
                                <i class="bi bi-eye" id="editPassIcon"></i>
                            </button>
                        </div>
                        <div class="form-text small text-muted">Solo ingrésala si deseas cambiarla (mínimo 6 caracteres).</div>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input name="IsActive" value="true" class="form-check-input" type="checkbox" id="editIsActiveSwitch" />
                        <label class="form-check-label small fw-medium text-secondary" for="editIsActiveSwitch">
                            Empleado activo (habilitado para iniciar sesión)
                        </label>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-madero rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Guardar empleado
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Confirmar Eliminación (HU-18 CA-05) -->
<div class="modal fade" id="deleteEmployeeModal" tabindex="-1" aria-labelledby="deleteEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <h5 class="modal-title fw-bold text-danger font-serif" id="deleteEmployeeModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Eliminar empleado
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <p class="mb-3 text-secondary">
                    ¿Estás seguro de que deseas eliminar permanentemente a <strong class="text-madero-dark" id="deleteEmployeeName"></strong>?
                </p>
                <div class="alert alert-warning small mb-0 py-2">
                    <i class="bi bi-info-circle me-1"></i> Esta acción retirará al colaborador del sistema y ya no podrá iniciar sesión. Los pedidos registrados históricamente se mantendrán intactos.
                </div>
            </div>
            <div class="modal-footer border-top px-4 py-3 bg-light rounded-bottom-4">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <form id="deleteEmployeeForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Generación dinámica y automática del nombre de usuario (Nuevo empleado)
        let debounceTimer;
        const fullNameInput = document.getElementById('fullNameInput');
        const generatedUserInput = document.getElementById('generatedUserNameInput');
        const form = document.getElementById('createEmployeeForm');
        const cancelBtn = document.getElementById('cancelEmployeeBtn');

        fullNameInput?.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            const val = this.value.trim();
            if (val.length < 3) {
                generatedUserInput.value = '';
                return;
            }

            debounceTimer = setTimeout(() => {
                fetch(`/Employee/GenerateUsername?fullName=${encodeURIComponent(val)}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data && data.username) {
                            generatedUserInput.value = data.username;
                        }
                    })
                    .catch(err => console.error("Error al generar usuario:", err));
            }, 300);
        });

        // Limpiar formulario al cancelar nuevo empleado
        cancelBtn?.addEventListener('click', function () {
            form.reset();
            generatedUserInput.value = '';
        });

        // Toggle ver contraseña inicial (Nuevo empleado)
        document.getElementById('toggleEmpPassBtn')?.addEventListener('click', function () {
            const passInput = document.getElementById('initialPassInput');
            const icon = document.getElementById('empPassIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });

        // Toggle ver contraseña (Editar empleado)
        document.getElementById('toggleEditPassBtn')?.addEventListener('click', function () {
            const passInput = document.getElementById('editPassInput');
            const icon = document.getElementById('editPassIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });

        // Abrir y cargar datos en modal de edición (HU-18 CA-01)
        function openEditModal(empId) {
            fetch(`/Employee/GetForEdit?id=${encodeURIComponent(empId)}`)
                .then(res => {
                    if (!res.ok) throw new Error("No se pudo obtener el colaborador.");
                    return res.json();
                })
                .then(data => {
                    document.getElementById('editId').value = data.id;
                    document.getElementById('editFullName').value = data.fullName;
                    document.getElementById('editDNI').value = data.dni;
                    document.getElementById('editPhone').value = data.phone;
                    document.getElementById('editUserName').value = data.userName;
                    document.getElementById('editRole').value = data.role;
                    document.getElementById('editPassInput').value = '';
                    document.getElementById('editIsActiveSwitch').checked = data.isActive;

                    const modal = new bootstrap.Modal(document.getElementById('editEmployeeModal'));
                    modal.show();
                })
                .catch(err => {
                    alert("Error al cargar datos del empleado.");
                    console.error(err);
                });
        }

        // Abrir modal de confirmación de eliminación (HU-18 CA-05)
        function openDeleteModal(empId, fullName) {
            document.getElementById('deleteEmployeeName').textContent = fullName;
            document.getElementById('deleteEmployeeForm').action = `/Employee/Delete/${encodeURIComponent(empId)}`;
            const modal = new bootstrap.Modal(document.getElementById('deleteEmployeeModal'));
            modal.show();
        }
    </script>
}
