@model software_elviejomadero.ViewModels.EmployeeListViewModel

@{
    ViewData["Title"] = "Gestión de Empleados";
}

<!-- Header de Administración con navegación -->
<div class="admin-header bg-white rounded-4 p-4 shadow-sm mb-4 border">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-madero-soft text-madero fw-medium rounded-pill px-3 py-1">Administración</span>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-1">
                    <i class="bi bi-people-fill small me-1"></i> Capital Humano
                </span>
            </div>
            <h1 class="h3 fw-bold text-madero-dark mt-2 mb-1">Administración</h1>
            <p class="text-muted mb-0">Operación, carta, empleados y resultados de El Viejo Madero.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-madero rounded-pill px-4 shadow-sm" data-bs-toggle="modal" data-bs-target="#newEmployeeModal">
                <i class="bi bi-plus-lg me-1"></i> Nuevo empleado
            </button>
        </div>
    </div>

    <!-- Navegación por Pestañas / Tabs -->
    <ul class="nav nav-pills admin-tabs pt-2 border-top">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Administration" asp-action="Index">
                <i class="bi bi-speedometer2 me-1"></i> Resumen
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Dish" asp-action="Index">
                <i class="bi bi-journal-text me-1"></i> Carta
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-controller="Employee" asp-action="Index">
                <i class="bi bi-people me-1"></i> Empleados
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link disabled text-muted opacity-50" href="#" tabindex="-1" aria-disabled="true">
                <i class="bi bi-bar-chart me-1"></i> Reportes
            </a>
        </li>
    </ul>
</div>

<!-- Sección: Gestión de empleados -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
    <div class="card-header bg-white border-bottom p-4 d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
        <div>
            <h2 class="h5 fw-bold text-madero-dark mb-1">Gestión de empleados</h2>
            <div class="text-muted small">
                <span class="fw-semibold text-madero">@Model.TotalCount</span> colaboradores registrados
            </div>
        </div>

        <!-- Filtro por Rol -->
        <div class="d-flex align-items-center gap-2">
            <label for="roleFilterSelect" class="small text-muted fw-medium d-none d-sm-block">Filtrar:</label>
            <form method="get" asp-action="Index" class="d-flex align-items-center">
                <select name="role" id="roleFilterSelect" class="form-select form-select-sm rounded-pill pe-4" onchange="this.form.submit()">
                    <option value="">Todos los roles</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        <option value="@role" selected="@(Model.SelectedRole == role)">@role</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 custom-table">
            <thead class="table-light text-secondary small text-uppercase">
                <tr>
                    <th class="ps-4 py-3">Empleado</th>
                    <th class="py-3">Contacto</th>
                    <th class="py-3">Usuario</th>
                    <th class="py-3">Rol</th>
                    <th class="py-3 text-center">Estado</th>
                    <th class="pe-4 py-3 text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Employees.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-people display-6 d-block mb-2 text-muted-50"></i>
                            No se encontraron empleados registrados con el filtro seleccionado.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model.Employees)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle-sm bg-madero-soft text-madero fw-bold">
                                        @emp.FullName.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-madero-dark">@emp.FullName</div>
                                        <div class="text-muted small">Registrado: @emp.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small">
                                    <div><i class="bi bi-card-heading me-1 text-muted"></i> DNI: <strong>@emp.DNI</strong></div>
                                    <div><i class="bi bi-telephone me-1 text-muted"></i> @emp.Phone</div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border px-2 py-1 font-monospace">
                                    @@@emp.UserName
                                </span>
                            </td>
                            <td>
                                <span class="badge rounded-pill px-3 py-1 @(emp.Role == "Administrador" ? "bg-danger-subtle text-danger border border-danger-subtle" :
                                                                          emp.Role == "Mozo" ? "bg-primary-subtle text-primary border border-primary-subtle" :
                                                                          emp.Role == "Cocinero" ? "bg-warning-subtle text-warning-emphasis border border-warning-subtle" :
                                                                          emp.Role == "Recepcionista" ? "bg-info-subtle text-info-emphasis border border-info-subtle" :
                                                                          "bg-secondary-subtle text-secondary border border-secondary-subtle")">
                                    @emp.Role
                                </span>
                            </td>
                            <td class="text-center">
                                @if (emp.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-check-circle-fill me-1"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2 py-1">
                                        <i class="bi bi-slash-circle me-1"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="pe-4 text-end">
                                <button type="button" class="btn btn-sm btn-light text-muted border-0 rounded-circle" 
                                        title="Editar empleado" disabled>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-light text-muted border-0 rounded-circle ms-1" 
                                        title="Desactivar empleado" disabled>
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal: Nuevo Empleado -->
<div class="modal fade" id="newEmployeeModal" tabindex="-1" aria-labelledby="newEmployeeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom px-4 pt-4 pb-3">
                <div>
                    <h5 class="modal-title fw-bold text-madero-dark" id="newEmployeeModalLabel">Nuevo empleado</h5>
                    <p class="text-muted small mb-0">Registra un nuevo colaborador con su rol y credenciales de acceso.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form asp-controller="Employee" asp-action="Create" method="post" id="createEmployeeForm" autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="modal-body px-4 py-3">
                    <div class="mb-3">
                        <label asp-for="NewEmployee.FullName" class="form-label small fw-semibold text-secondary"></label>
                        <input asp-for="NewEmployee.FullName" name="FullName" class="form-control" id="fullNameInput" placeholder="Ej: Juan Pérez García" required />
                        <span asp-validation-for="NewEmployee.FullName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label asp-for="NewEmployee.DNI" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="NewEmployee.DNI" name="DNI" class="form-control" maxlength="8" placeholder="8 dígitos" required />
                            <span asp-validation-for="NewEmployee.DNI" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="NewEmployee.Phone" class="form-label small fw-semibold text-secondary"></label>
                            <input asp-for="NewEmployee.Phone" name="Phone" class="form-control" maxlength="9" placeholder="9 dígitos" required />
                            <span asp-validation-for="NewEmployee.Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewEmployee.UserName" class="form-label small fw-semibold text-secondary">
                            Nombre de usuario <span class="badge bg-light text-muted border ms-1">Generado automáticamente</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted">@@</span>
                            <input asp-for="NewEmployee.UserName" name="UserName" class="form-control bg-light font-monospace" id="generatedUserNameInput" readonly placeholder="Se autogenera al ingresar el nombre" />
                        </div>
                        <div class="form-text small text-muted">Formato: primera letra del nombre + primer apellido (ej: jperez).</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewEmployee.Role" class="form-label small fw-semibold text-secondary"></label>
                        <select asp-for="NewEmployee.Role" name="Role" class="form-select" required>
                            <option value="">Seleccione un rol...</option>
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span asp-validation-for="NewEmployee.Role" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewEmployee.InitialPassword" class="form-label small fw-semibold text-secondary"></label>
                        <div class="input-group">
                            <input asp-for="NewEmployee.InitialPassword" name="InitialPassword" type="password" class="form-control" id="initialPassInput" placeholder="••••••••" required />
                            <button class="btn btn-outline-secondary" type="button" id="toggleEmpPassBtn">
                                <i class="bi bi-eye" id="empPassIcon"></i>
                            </button>
                        </div>
                        <div class="form-text small text-muted">Mínimo 6 caracteres. Compartir de manera segura con el colaborador.</div>
                    </div>

                    <div class="form-check form-switch mb-2">
                        <input asp-for="NewEmployee.IsActive" name="IsActive" value="true" class="form-check-input" type="checkbox" id="employeeActiveSwitch" checked />
                        <label class="form-check-label small fw-medium text-secondary" for="employeeActiveSwitch">
                            Empleado activo (habilitado para iniciar sesión)
                        </label>
                    </div>
                </div>

                <div class="modal-footer border-top px-4 py-3 bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal" id="cancelEmployeeBtn">
                        Cancelar
                    </button>
                    <button type="submit" class="btn btn-madero rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Guardar empleado
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Generación dinámica y automática del nombre de usuario
        let debounceTimer;
        const fullNameInput = document.getElementById('fullNameInput');
        const generatedUserInput = document.getElementById('generatedUserNameInput');
        const form = document.getElementById('createEmployeeForm');
        const cancelBtn = document.getElementById('cancelEmployeeBtn');

        fullNameInput?.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            const val = this.value.trim();
            if (val.length < 3) {
                generatedUserInput.value = '';
                return;
            }

            debounceTimer = setTimeout(() => {
                fetch(`/Employee/GenerateUsername?fullName=${encodeURIComponent(val)}`)
                    .then(response => response.json())
                    .then(data => {
                        if (data && data.username) {
                            generatedUserInput.value = data.username;
                        }
                    })
                    .catch(err => console.error("Error al generar usuario:", err));
            }, 300);
        });

        // Limpiar formulario al cancelar
        cancelBtn?.addEventListener('click', function () {
            form.reset();
            generatedUserInput.value = '';
        });

        // Toggle ver contraseña inicial
        document.getElementById('toggleEmpPassBtn')?.addEventListener('click', function () {
            const passInput = document.getElementById('initialPassInput');
            const icon = document.getElementById('empPassIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });
    </script>
}
