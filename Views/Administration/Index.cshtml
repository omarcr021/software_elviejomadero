@{
    ViewData["Title"] = "Panel de Administración";
}

<!-- Header de Administración con navegación -->
<div class="admin-header bg-white rounded-4 p-4 shadow-sm mb-4 border">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
        <div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-madero-soft text-madero fw-medium rounded-pill px-3 py-1">Administración</span>
                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-1">
                    <i class="bi bi-circle-fill small me-1"></i> Sistema Operativo
                </span>
            </div>
            <h1 class="h3 fw-bold text-madero-dark mt-2 mb-1">Administración</h1>
            <p class="text-muted mb-0">Operación, carta, empleados y resultados de El Viejo Madero.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Dish" asp-action="Index" class="btn btn-outline-madero rounded-pill px-3">
                <i class="bi bi-journal-text me-1"></i> Ir a la Carta
            </a>
            <a asp-controller="Employee" asp-action="Index" class="btn btn-madero rounded-pill px-3">
                <i class="bi bi-people me-1"></i> Ir a Empleados
            </a>
        </div>
    </div>

    <!-- Navegación por Pestañas / Tabs -->
    <ul class="nav nav-pills admin-tabs pt-2 border-top">
        <li class="nav-item">
            <a class="nav-link active" asp-controller="Administration" asp-action="Index">
                <i class="bi bi-speedometer2 me-1"></i> Resumen
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Dish" asp-action="Index">
                <i class="bi bi-journal-text me-1"></i> Carta
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Employee" asp-action="Index">
                <i class="bi bi-people me-1"></i> Empleados
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link disabled text-muted opacity-50" href="#" tabindex="-1" aria-disabled="true">
                <i class="bi bi-bar-chart me-1"></i> Reportes
            </a>
        </li>
    </ul>
</div>

<!-- Tarjetas de Resumen Operativo -->
<div class="row g-4 mb-4">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Platos en Carta</span>
                <div class="stat-icon-wrapper rounded-3 bg-madero-soft text-madero p-2">
                    <i class="bi bi-journal-check fs-5"></i>
                </div>
            </div>
            <h2 class="display-6 fw-bold text-madero-dark mb-1">@ViewBag.TotalDishes</h2>
            <div class="d-flex align-items-center gap-1 text-success small">
                <i class="bi bi-check-circle"></i>
                <span>@ViewBag.ActiveDishes platos visibles en menú</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Colaboradores</span>
                <div class="stat-icon-wrapper rounded-3 bg-primary-subtle text-primary p-2">
                    <i class="bi bi-people fs-5"></i>
                </div>
            </div>
            <h2 class="display-6 fw-bold text-madero-dark mb-1">@ViewBag.TotalEmployees</h2>
            <div class="d-flex align-items-center gap-1 text-success small">
                <i class="bi bi-person-check"></i>
                <span>@ViewBag.ActiveEmployees colaboradores activos</span>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Seguridad & Acceso</span>
                <div class="stat-icon-wrapper rounded-3 bg-warning-subtle text-warning p-2">
                    <i class="bi bi-shield-check fs-5"></i>
                </div>
            </div>
            <h2 class="h4 fw-bold text-madero-dark mb-1">Perfiles de Acceso</h2>
            <div class="text-muted small">
                5 roles operativos habilitados
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-xl-3">
        <div class="card stat-card border-0 shadow-sm rounded-4 p-3 bg-white">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="text-muted small fw-semibold">Estado de Operación</span>
                <div class="stat-icon-wrapper rounded-3 bg-success-subtle text-success p-2">
                    <i class="bi bi-shop fs-5"></i>
                </div>
            </div>
            <h2 class="h4 fw-bold text-success mb-1">En Servicio</h2>
            <div class="text-muted small">
                Salón y atención disponibles
            </div>
        </div>
    </div>
</div>

<!-- Accesos directos a módulos de administración -->
<div class="row g-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-3 bg-madero-soft text-madero p-3">
                    <i class="bi bi-journal-text fs-3"></i>
                </div>
                <div>
                    <h3 class="h5 fw-bold text-madero-dark mb-1">Gestión de la Carta</h3>
                    <p class="text-muted small mb-0">Registrar, actualizar, ocultar y organizar los platos clasificados por categoría.</p>
                </div>
            </div>
            <div class="mt-auto pt-3 border-top d-flex justify-content-end">
                <a asp-controller="Dish" asp-action="Index" class="btn btn-madero rounded-pill px-4">
                    Administrar Carta <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-3 bg-primary-subtle text-primary p-3">
                    <i class="bi bi-person-plus fs-3"></i>
                </div>
                <div>
                    <h3 class="h5 fw-bold text-madero-dark mb-1">Gestión de Colaboradores</h3>
                    <p class="text-muted small mb-0">Alta de personal, credenciales de acceso, asignación de rol y directorio del equipo.</p>
                </div>
            </div>
            <div class="mt-auto pt-3 border-top d-flex justify-content-end">
                <a asp-controller="Employee" asp-action="Index" class="btn btn-outline-madero rounded-pill px-4">
                    Administrar Empleados <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>
