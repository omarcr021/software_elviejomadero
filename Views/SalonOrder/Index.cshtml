@model software_elviejomadero.ViewModels.SalonTablesViewModel
@{
    ViewData["Title"] = "Mozo";
}

<link rel="stylesheet" href="~/css/mozo-salon.css" asp-append-version="true" />

<div class="vm-admin-wrapper vm-mozo">
    <div class="vm-mozo-header">
        <h1 class="vm-mozo-title">Mozo</h1>
        <p class="vm-mozo-subtitle">Entrega los platos listos, atiende las mesas y toma nuevos pedidos.</p>
    </div>

    @* "Listos para entregar" + "Mesas del salón": se refrescan solos (HU-02, criterio 4) *@
    <div id="salonBoard" data-board-url="@Url.Action("Board", "SalonOrder")" data-detail-url="@Url.Action("TableDetail", "SalonOrder")">
        <partial name="_Board" model="Model" />
    </div>
</div>

<form id="salonAntiTokenForm" style="display:none;">@Html.AntiForgeryToken()</form>

<!-- Detalle de mesa (HU-02 y HU-07) -->
<div class="modal fade" id="tableModal" tabindex="-1" aria-labelledby="tableModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content vm-mozo-modal">
            <div id="tableModalBody" class="vm-mozo-modal-body" aria-live="polite"></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(() => {
    const board = document.getElementById('salonBoard');
    const modalEl = document.getElementById('tableModal');
    const modalBody = document.getElementById('tableModalBody');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    const POLL_MS = 4000;
    let lastHtml = board.innerHTML.trim();
    let busy = false;

    // HU-05: no se actualiza el tiempo en el servidor cada segundo.
    // Se calcula en el navegador desde la hora UTC en que el pedido se envió a cocina.
    function updateElapsedMinutes() {
        const now = Date.now();
        board.querySelectorAll('[data-hu05-start]').forEach(tile => {
            const startedAt = Date.parse(tile.dataset.hu05Start);
            const estimate = Number(tile.dataset.hu05Estimate);
            const label = tile.querySelector('[data-hu05-minutes]');
            if (!Number.isFinite(startedAt) || !Number.isFinite(estimate) || !label) return;
            const elapsed = Math.max(0, Math.floor((now - startedAt) / 60000));
            const next = `${elapsed}/${estimate} min`;
            if (label.textContent !== next) label.textContent = next;
        });
    }
    updateElapsedMinutes();
    setInterval(updateElapsedMinutes, 15000);

    // Tocar una mesa -> pide su detalle actualizado al servidor.
    board.addEventListener('click', async e => {
        const tile = e.target.closest('[data-table-id]');
        if (!tile) return;
        modalBody.innerHTML = '<p class="vm-mozo-loading">Cargando…</p>';
        modal.show();
        try {
            const res = await fetch(`${board.dataset.detailUrl}?tableId=${encodeURIComponent(tile.dataset.tableId)}`,
                { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin' });
            if (!res.ok || res.redirected) throw new Error();
            modalBody.innerHTML = await res.text();
        } catch {
            modalBody.innerHTML = '<p class="vm-mozo-loading text-danger">No se pudo cargar la mesa. Inténtalo de nuevo.</p>';
        }
    });

    // HU-07 CA-02: Servir a la mesa via AJAX sin recargar página
    modalBody.addEventListener('submit', async e => {
        const form = e.target.closest('.vm-serve-form');
        if (!form) return;
        e.preventDefault();
        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;
        try {
            const formData = new FormData(form);
            const res = await fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: formData
            });
            if (res.ok) {
                modalBody.innerHTML = await res.text();
                refresh();
            } else {
                alert('No se pudo marcar el pedido como servido.');
                if (submitBtn) submitBtn.disabled = false;
            }
        } catch {
            alert('Error al comunicar con el servidor.');
            if (submitBtn) submitBtn.disabled = false;
        }
    });

    // HU-07 CA-05: Liberar mesa via AJAX
    modalBody.addEventListener('click', async e => {
        const freeBtn = e.target.closest('[data-free-table]');
        if (!freeBtn || freeBtn.disabled) return;
        if (!confirm('¿Confirmas que el cliente pagó y deseas liberar la mesa?')) return;
        freeBtn.disabled = true;
        try {
            const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenEl ? tokenEl.value : '';
            const formData = new URLSearchParams();
            formData.append('tableId', freeBtn.dataset.freeTable);
            if (token) formData.append('__RequestVerificationToken', token);

            const headers = { 
                'X-Requested-With': 'XMLHttpRequest', 
                'Content-Type': 'application/x-www-form-urlencoded' 
            };
            if (token) headers['RequestVerificationToken'] = token;

            const res = await fetch('@Url.Action("FreeTable", "SalonOrder")', {
                method: 'POST',
                headers: headers,
                body: formData
            });

            if (!res.ok) {
                let errorText = 'Error al comunicar con el servidor.';
                try {
                    const errJson = await res.json();
                    if (errJson && errJson.errorMessage) errorText = errJson.errorMessage;
                } catch { }
                alert(errorText);
                freeBtn.disabled = false;
                return;
            }

            const json = await res.json();
            if (json.succeeded) {
                modal.hide();
                refresh();
            } else {
                alert(json.errorMessage || 'No se pudo liberar la mesa.');
                freeBtn.disabled = false;
            }
        } catch (err) {
            console.error('Error al liberar la mesa:', err);
            alert('Error al liberar la mesa.');
            freeBtn.disabled = false;
        }
    });

    // Actualización automática: refleja lo que otros mozos ocupan o liberan, sin recargar la página.
    async function refresh() {
        if (busy || document.hidden) return;
        busy = true;
        try {
            const res = await fetch(board.dataset.boardUrl,
                { headers: { 'X-Requested-With': 'XMLHttpRequest' }, credentials: 'same-origin', cache: 'no-store' });
            if (res.ok && !res.redirected) {
                const html = (await res.text()).trim();
                if (html && html !== lastHtml) {
                    board.innerHTML = html;
                    lastHtml = html;
                    updateElapsedMinutes();
                }
            }
        } catch { /* sin red: se reintenta en el próximo ciclo */ }
        finally { busy = false; }
    }
    setInterval(refresh, POLL_MS);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
})();
</script>
}
