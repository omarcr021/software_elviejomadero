@model software_elviejomadero.ViewModels.KitchenBoardViewModel

@{
    ViewData["Title"] = "Cocina — comandas";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Merriweather:wght@700&display=swap');

    :root {
        --kc-ink: #2b1d14;
        --kc-muted: #7a6c5a;
        --kc-brown: #5a3a28;
        --kc-brown-dark: #46291a;
        --kc-orange: #d98530;
        --kc-panel: #f1ece0;
        --kc-panel-border: #ddd3bf;
        --kc-card: #fffbf3;
        --kc-card-border: #e8dfcd;
        --kc-serif: 'Merriweather', Georgia, 'Times New Roman', serif;
    }

    /* Encabezado */
    .kc-page-title { font-family: var(--kc-serif); font-weight: 700; font-size: 1.6rem; color: var(--kc-ink); margin: 0 0 .25rem; }
    .kc-page-sub { color: var(--kc-muted); font-size: .9rem; margin: 0 0 1.25rem; }

    /* Aviso de conexión: solo aparece si falla la actualización */
    .kc-live { display: none; margin-bottom: .75rem; font-size: .85rem; color: #a3402f; }
    .kc-live.is-offline { display: block; }

    /* Tablero */
    .kc-board { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; align-items: stretch; }
    @@media (max-width: 991.98px) { .kc-board { grid-template-columns: 1fr; } }

    .kc-column { background: var(--kc-panel); border: 1px solid var(--kc-panel-border); border-radius: 16px; padding: 1rem; min-height: 22rem; }

    .kc-col-head { display: flex; align-items: center; gap: .6rem; margin-bottom: .9rem; }
    .kc-col-icon { width: 30px; height: 30px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: .95rem; flex-shrink: 0; }
    .kc-icon-new   { background: var(--kc-orange); color: #fff; }
    .kc-icon-prep  { background: var(--kc-brown);  color: #fff; }
    .kc-icon-ready { background: #c6d1bb; color: #2f3b2a; }
    .kc-col-title { font-family: var(--kc-serif); font-size: .95rem; font-weight: 700; color: var(--kc-ink); margin: 0; flex: 1; }
    .kc-count { background: #e5ddcc; color: #5a4a3a; font-size: .75rem; font-weight: 600; padding: .1rem .55rem; border-radius: 999px; min-width: 1.6rem; text-align: center; }

    /* Columna vacía */
    .kc-empty { border: 1.5px dashed #d3c8b2; border-radius: 12px; padding: 1.7rem 1rem; text-align: center; color: #8b7e6c; font-size: .9rem; }

    /* Tarjeta de pedido */
    .kc-card { background: var(--kc-card); border: 1px solid var(--kc-card-border); border-radius: 12px; padding: .9rem 1rem; margin-bottom: .75rem; box-shadow: 0 1px 2px rgba(60, 40, 20, .06); }
    .kc-card:last-child { margin-bottom: 0; }
    .kc-card-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: .55rem; }
    .kc-code { font-family: var(--kc-serif); font-weight: 700; font-size: 1.1rem; color: var(--kc-ink); }
    .kc-time { font-size: .78rem; color: var(--kc-muted); white-space: nowrap; display: inline-flex; align-items: center; gap: .3rem; }

    .kc-origin { display: flex; justify-content: space-between; align-items: center; gap: .5rem; font-size: .78rem; color: var(--kc-muted); padding-bottom: .6rem; border-bottom: 1px solid #e6dccb; }
    .kc-origin-label { display: inline-flex; align-items: center; gap: .35rem; }
    .kc-customer { color: var(--kc-ink); text-align: right; }

    .kc-items { list-style: none; margin: .6rem 0 .5rem; padding: 0; }
    .kc-items li { padding: .15rem 0; font-size: .85rem; color: var(--kc-ink); }
    .kc-qty { color: var(--kc-orange); font-weight: 700; font-size: .8rem; margin-right: .2rem; }

    .kc-note { background: #f1e9db; color: #6b5a48; font-size: .75rem; padding: .4rem .6rem; border-radius: 6px; margin-bottom: .6rem; }

    /* Botones */
    .kc-btn { display: flex; align-items: center; justify-content: center; gap: .45rem; width: 100%; border: 0; border-radius: 8px; padding: .55rem 1rem; color: #fff; font-size: .85rem; font-weight: 600; cursor: pointer; transition: background .15s ease; }
    .kc-btn:disabled { opacity: .6; cursor: default; }
    .kc-btn:focus-visible { outline: 3px solid rgba(217, 133, 48, .5); outline-offset: 2px; }
    .kc-btn-start { background: var(--kc-brown); }
    .kc-btn-start:hover:not(:disabled) { background: var(--kc-brown-dark); }
    .kc-btn-ready { background: #3f6b4a; }
    .kc-btn-ready:hover:not(:disabled) { background: #335a3d; }

    /* Pedido listo */
    .kc-ready-info { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .4rem; margin-top: .2rem; }
    .kc-ready-badge { background: #e3ecdb; color: #2f5a36; font-size: .75rem; font-weight: 600; padding: .2rem .65rem; border-radius: 999px; }
    .kc-responsible { font-size: .75rem; color: var(--kc-muted); }
    .kc-responsible strong { color: var(--kc-ink); }

    /* Avisos */
    .kc-toasts { position: fixed; right: 1rem; bottom: 1rem; z-index: 1080; display: flex; flex-direction: column; gap: .5rem; }
    .kc-toast { padding: .65rem 1rem; border-radius: 8px; color: #fff; font-size: .85rem; box-shadow: 0 4px 14px rgba(0, 0, 0, .18); max-width: 22rem; }
    .kc-toast-success { background: #3f6b4a; }
    .kc-toast-danger { background: #a3402f; }
</style>

<h1 class="kc-page-title">Cocina — comandas</h1>
<p class="kc-page-sub">Los pedidos entran automáticamente. Muévelos según avance la preparación.</p>

<div id="kcLive" class="kc-live"><i class="bi bi-wifi-off me-1"></i><span id="kcLiveText"></span></div>

<form id="kcAntiforgery" method="post">@Html.AntiForgeryToken()</form>

<div id="kitchenBoard">
    <partial name="_Board" model="Model" />
</div>

<div id="kcToasts" class="kc-toasts" aria-live="polite"></div>

@section Scripts {
    <script>
        (function () {
            const board = document.getElementById('kitchenBoard');
            const toasts = document.getElementById('kcToasts');
            const live = document.getElementById('kcLive');
            const liveText = document.getElementById('kcLiveText');
            const token = document.querySelector('#kcAntiforgery input[name="__RequestVerificationToken"]').value;

            const urls = {
                board: '@Url.Action("Board", "Kitchen")',
                start: '@Url.Action("StartPreparation", "Kitchen")',
                ready: '@Url.Action("MarkAsReady", "Kitchen")'
            };

            const POLL_MS = 8000;
            let serverOffset = 0;   // servidor - navegador, en ms
            let busy = false;

            // Misma lógica que KitchenOrderViewModel.FormatElapsed
            function formatElapsed(ms) {
                const total = Math.max(0, Math.floor(ms / 60000));
                if (total < 1) return 'recién';
                if (total < 60) return 'hace ' + total + ' min';
                return 'hace ' + Math.floor(total / 60) + ' h ' + String(total % 60).padStart(2, '0') + ' min';
            }

            function syncOffset() {
                const root = board.querySelector('[data-server-now]');
                if (root) serverOffset = Number(root.dataset.serverNow) - Date.now();
            }

            function tick() {
                const now = Date.now() + serverOffset;
                board.querySelectorAll('[data-created-ms]').forEach(function (el) {
                    el.textContent = formatElapsed(now - Number(el.dataset.createdMs));
                });
            }

            function setLive(ok) {
                live.classList.toggle('is-offline', !ok);
                liveText.textContent = ok ? '' : 'Sin conexión, reintentando…';
            }

            function toast(message, type) {
                const el = document.createElement('div');
                el.className = 'kc-toast kc-toast-' + type;
                el.textContent = message;
                toasts.appendChild(el);
                setTimeout(function () { el.remove(); }, 3500);
            }

            function sessionExpired(response) {
                // Si la sesión caducó, el servidor redirige al login
                if (response.redirected || response.status === 401 || response.status === 403) {
                    window.location.reload();
                    return true;
                }
                return false;
            }

            async function refresh() {
                if (busy) return;
                try {
                    const response = await fetch(urls.board, { cache: 'no-store', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (sessionExpired(response)) return;
                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    board.innerHTML = await response.text();
                    syncOffset();
                    tick();
                    setLive(true);
                } catch (err) {
                    setLive(false);
                }
            }

            board.addEventListener('click', async function (e) {
                const btn = e.target.closest('[data-action]');
                if (!btn || btn.disabled) return;

                busy = true;
                btn.disabled = true;
                try {
                    const response = await fetch(urls[btn.dataset.action], {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token,
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: new URLSearchParams({ id: btn.dataset.id })
                    });
                    if (sessionExpired(response)) return;
                    const data = await response.json();
                    toast(data.message, data.success ? 'success' : 'danger');
                } catch (err) {
                    toast('No se pudo actualizar el pedido. Revisa la conexión e inténtalo de nuevo.', 'danger');
                    btn.disabled = false;
                } finally {
                    busy = false;
                    refresh();
                }
            });

            syncOffset();
            tick();
            setInterval(tick, 1000);
            setInterval(refresh, POLL_MS);
        })();
    </script>
}
