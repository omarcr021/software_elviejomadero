@model software_elviejomadero.ViewModels.KitchenBoardViewModel

@{
    // HU-10: Sortable = true -> columnas que se mantienen ordenadas por tiempo de espera
    var columns = new[]
    {
        (Title: "Nuevos",          Orders: Model.NewOrders,           Empty: "Sin comandas nuevas",      Css: "kc-icon-new",   Icon: "bi-clock",        Sortable: true),
        (Title: "En preparación",  Orders: Model.InPreparationOrders, Empty: "Nada en preparación",      Css: "kc-icon-prep",  Icon: "bi-fire",         Sortable: true),
        (Title: "Listos",          Orders: Model.ReadyOrders,         Empty: "Aún no hay platos listos", Css: "kc-icon-ready", Icon: "bi-check-circle", Sortable: false)
    };
}

<div class="kc-board" data-server-now="@Model.ServerNowUnixMs">
    @foreach (var col in columns)
    {
        <section class="kc-column" aria-label="@col.Title" data-sortable="@(col.Sortable ? "true" : "false")">
            <header class="kc-col-head">
                <span class="kc-col-icon @col.Css"><i class="bi @col.Icon"></i></span>
                <h2 class="kc-col-title">@col.Title</h2>
                <span class="kc-count" aria-label="@col.Orders.Count pedidos">@col.Orders.Count</span>
            </header>

            @if (!col.Orders.Any())
            {
                <div class="kc-empty">@col.Empty</div>
            }
            else
            {
                foreach (var order in col.Orders)
                {
                    <partial name="_OrderCard" model="order" />
                }
            }
        </section>
    }
</div>
