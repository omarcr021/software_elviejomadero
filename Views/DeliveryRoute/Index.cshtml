@model software_elviejomadero.ViewModels.DeliveryRouteDashboardViewModel
@{
    ViewData["Title"] = "Despacho y rutas";
}

@functions {
    private string FormatPeruTime(DateTime? utcTime)
    {
        if (!utcTime.HasValue) return "—";
        try
        {
            var tz = TimeZoneInfo.FindSystemTimeZoneById("America/Lima");
            return TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utcTime.Value, DateTimeKind.Utc), tz).ToString("dd/MM/yyyy HH:mm") + " (Perú)";
        }
        catch
        {
            try
            {
                var tz = TimeZoneInfo.FindSystemTimeZoneById("SA Pacific Standard Time");
                return TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utcTime.Value, DateTimeKind.Utc), tz).ToString("dd/MM/yyyy HH:mm") + " (Perú)";
            }
            catch
            {
                return utcTime.Value.AddHours(-5).ToString("dd/MM/yyyy HH:mm") + " (Perú)";
            }
        }
    }
}

<div class="vm-admin-wrapper">
    <div class="vm-admin-header">
        <div>
            <h1 class="vm-page-title"><i class="bi bi-bicycle me-2"></i>Despacho y rutas</h1>
            <p class="vm-page-subtitle">Gestiona pedidos listos, rutas activas y entregas.</p>
        </div>
        <div class="d-flex gap-2">
            <div class="vm-route-counter"><small>Pendientes</small><strong>@Model.Ready.Count</strong></div>
            <div class="vm-route-counter"><small>En ruta</small><strong>@Model.InRoute.Count</strong></div>
            <div class="vm-route-counter"><small>Historial</small><strong>@Model.History.Count</strong></div>
        </div>
    </div>

    <div class="vm-route-tabs">
        <a href="#readyOrders">Despacho activo (@Model.Ready.Count)</a>
        <a href="#routeOrders">En ruta (@Model.InRoute.Count)</a>
        <a href="#historyOrders">Historial (@Model.History.Count)</a>
        <a asp-action="Index">Actualizar</a>
    </div>

    <section id="readyOrders" class="mt-4">
        <h2 class="vm-section-heading">Listos para despacho</h2>
        @if (!Model.Ready.Any())
        {
            <div class="vm-empty-box">No hay pedidos listos para despacho.</div>
        }
        @foreach (var order in Model.Ready)
        {
            <article class="vm-dispatch-card">
                <div class="vm-dispatch-heading">
                    <strong>@order.Code</strong>
                    <span class="vm-route-badge">Listo para despacho</span>
                    <strong>S/ @order.Total.ToString("F2")</strong>
                </div>
                <p class="vm-route-meta">
                    <i class="bi bi-person me-1"></i>@order.CustomerName 
                    <i class="bi bi-geo-alt ms-3 me-1"></i>@order.Address 
                    <i class="bi bi-basket ms-3 me-1"></i>@order.ItemsCount productos
                </p>
                <details class="vm-route-details">
                    <summary>Ver detalle del pedido</summary>
                    <p><strong>Teléfono:</strong> @order.Phone</p>
                    <p><strong>Dirección:</strong> @order.Address</p>
                    @foreach (var item in order.Items)
                    {
                        <p class="mb-1">@item.Quantity × @item.Name — S/ @item.UnitPrice.ToString("F2") c/u</p>
                    }
                    <p class="mt-2"><strong>Monto a cobrar:</strong> S/ @order.Total.ToString("F2")</p>
                </details>
                <form asp-action="Start" asp-route-id="@order.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button class="vm-btn-save mt-3" type="submit">
                        <i class="bi bi-sign-turn-right me-1"></i> Aceptar e iniciar ruta
                    </button>
                </form>
            </article>
        }
    </section>

    <section id="routeOrders" class="mt-4">
        <h2 class="vm-section-heading">Mis pedidos en ruta</h2>
        @if (!Model.InRoute.Any())
        {
            <div class="vm-empty-box">Aún no tienes pedidos en ruta.</div>
        }
        @foreach (var order in Model.InRoute)
        {
            <article class="vm-dispatch-card">
                <div class="vm-dispatch-heading">
                    <strong>@order.Code</strong>
                    <span class="vm-route-badge vm-route-active">En camino</span>
                    <strong>S/ @order.Total.ToString("F2")</strong>
                </div>
                <p class="vm-route-meta">@order.CustomerName — @order.Address — @order.ItemsCount productos</p>
                <p class="small text-muted">Inicio de ruta: @FormatPeruTime(order.RouteStartedAt)</p>
                <details class="vm-route-details mb-3">
                    <summary>Ver detalle y contacto</summary>
                    <p><strong>Cliente:</strong> @order.CustomerName</p>
                    <p><strong>Teléfono:</strong> <a href="tel:@order.Phone">@order.Phone</a></p>
                    <p><strong>Dirección:</strong> @order.Address</p>
                    @foreach (var item in order.Items)
                    {
                        <p class="mb-1">@item.Quantity × @item.Name — S/ @item.UnitPrice.ToString("F2") c/u</p>
                    }
                    <p class="mt-2"><strong>Monto a cobrar:</strong> S/ @order.Total.ToString("F2")</p>
                </details>
                <button type="button" class="vm-btn-save" data-bs-toggle="modal" data-bs-target="#confirmDeliveryModal-@order.Id">
                    <i class="bi bi-check-circle me-1"></i> Confirmar entrega
                </button>
            </article>

            <!-- Modal Cierre de Ruta (HU-15) -->
            <div class="modal fade" id="confirmDeliveryModal-@order.Id" tabindex="-1" aria-labelledby="confirmDeliveryModalLabel-@order.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered vm-modal-dialog">
                    <div class="modal-content vm-modal-card">
                        <div class="vm-modal-header d-flex justify-content-between align-items-start">
                            <div>
                                <span class="vm-modal-tag">CIERRE DE RUTA</span>
                                <h2 class="vm-modal-title" id="confirmDeliveryModalLabel-@order.Id">Confirmar entrega</h2>
                                <p class="vm-modal-subtitle">Verifica que el cliente recibió el pedido @order.Code.</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <form asp-action="ConfirmDelivery" asp-route-id="@order.Id" method="post">
                            @Html.AntiForgeryToken()
                            <div class="vm-modal-body">
                                <div class="vm-delivery-summary-card">
                                    <p><strong>Cliente:</strong> @order.CustomerName</p>
                                    <p><strong>Dirección:</strong> @order.Address</p>
                                    <p class="vm-delivery-summary-total"><strong>Total:</strong> S/ @order.Total.ToString("F2")</p>
                                </div>
                                <div class="vm-field-group mb-0">
                                    <label for="deliveryNote-@order.Id" class="vm-modal-label">Nota de entrega (opcional)</label>
                                    <textarea id="deliveryNote-@order.Id" name="deliveryNote" class="vm-modal-textarea" rows="3" placeholder="Entregado."></textarea>
                                </div>
                            </div>
                            <div class="vm-modal-footer">
                                <button type="button" class="vm-btn-cancel" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="vm-btn-save">Confirmar y finalizar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </section>

    <section id="historyOrders" class="mt-4">
        <h2 class="vm-section-heading">Historial de entregas</h2>
        @if (!Model.History.Any())
        {
            <div class="vm-empty-box">Aún no tienes entregas registradas en tu historial.</div>
        }
        @foreach (var order in Model.History)
        {
            <article class="vm-dispatch-card">
                <div class="vm-dispatch-heading">
                    <strong>@order.Code</strong>
                    <span class="vm-route-badge vm-route-delivered"><i class="bi bi-check2-circle me-1"></i>Entregado</span>
                    <strong>S/ @order.Total.ToString("F2")</strong>
                </div>
                <p class="vm-route-meta">@order.CustomerName — @order.Address — @order.ItemsCount productos</p>
                <div class="d-flex flex-wrap gap-3 small text-muted mb-2">
                    <span><i class="bi bi-clock me-1"></i>Entregado: @FormatPeruTime(order.DeliveredAt)</span>
                    @if (order.DeliveryDurationMinutes.HasValue)
                    {
                        <span><i class="bi bi-stopwatch me-1"></i>Tiempo: @order.DeliveryDurationMinutes min</span>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(order.DeliveryNote))
                {
                    <p class="small text-muted mb-2">
                        <i class="bi bi-chat-left-text me-1"></i><strong>Nota de entrega:</strong> @order.DeliveryNote
                    </p>
                }
                <details class="vm-route-details">
                    <summary>Ver detalle del pedido entregado</summary>
                    <p><strong>Cliente:</strong> @order.CustomerName</p>
                    <p><strong>Teléfono:</strong> @order.Phone</p>
                    <p><strong>Dirección:</strong> @order.Address</p>
                    @foreach (var item in order.Items)
                    {
                        <p class="mb-1">@item.Quantity × @item.Name — S/ @item.UnitPrice.ToString("F2") c/u</p>
                    }
                    <p class="mt-2"><strong>Monto cobrado:</strong> S/ @order.Total.ToString("F2")</p>
                </details>
            </article>
        }
    </section>
</div>
