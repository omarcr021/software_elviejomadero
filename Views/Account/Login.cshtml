@model software_elviejomadero.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; // Login tiene vista dedicada inmersiva con identidad visual del prototipo
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - El Viejo Madero</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-login-page d-flex align-items-center min-vh-100 py-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-9">
                <div class="card card-login-wrapper shadow-lg border-0 overflow-hidden rounded-4">
                    <div class="row g-0">
                        <!-- Panel Izquierdo: Identidad Visual del Restaurante -->
                        <div class="col-md-6 login-brand-panel d-flex flex-column justify-content-between p-4 p-lg-5 text-white">
                            <div>
                                <div class="d-inline-flex align-items-center gap-2 mb-4 brand-pill px-3 py-2 rounded-pill">
                                    <i class="bi bi-fire text-warning fs-5"></i>
                                    <span class="fw-bold tracking-wide">EL VIEJO MADERO</span>
                                </div>
                                <h2 class="display-6 fw-bold mb-3">Sabor tradicional & gestión eficiente</h2>
                                <p class="text-white-50 fs-6 mb-0">
                                    Sistema integral de gestión de comandas, carta gastronómica y colaboradores.
                                </p>
                            </div>
                            <div class="mt-4 pt-3 border-top border-white-25">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="feature-icon-box rounded-circle bg-white-15 p-2 d-flex align-items-center justify-content-center">
                                        <i class="bi bi-shield-lock-fill text-warning fs-5"></i>
                                    </div>
                                    <div class="small">
                                        <span class="fw-semibold d-block text-white">Acceso Restringido</span>
                                        <span class="text-white-50">Solo para personal autorizado</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Panel Derecho: Formulario de Inicio de Sesión -->
                        <div class="col-md-6 bg-white p-4 p-lg-5 d-flex flex-column justify-content-center">
                            <div class="mb-4">
                                <h3 class="fw-bold text-madero-dark mb-1">Iniciar sesión</h3>
                                <p class="text-muted small">Ingresa tus credenciales para acceder a tus funciones.</p>
                            </div>

                            @if (!ViewData.ModelState.IsValid)
                            {
                                <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 border-0 d-flex align-items-center gap-2" role="alert">
                                    <i class="bi bi-exclamation-circle-fill text-danger fs-5"></i>
                                    <div>
                                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                        {
                                            <div>@error.ErrorMessage</div>
                                        }
                                    </div>
                                </div>
                            }

                            <form asp-controller="Account" asp-action="Login" method="post" id="loginForm" autocomplete="off">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="ReturnUrl" />

                                <div class="mb-3">
                                    <label asp-for="UserName" class="form-label small fw-semibold text-secondary"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="bi bi-person"></i>
                                        </span>
                                        <input asp-for="UserName" class="form-control bg-light border-start-0 ps-0" placeholder="Ej: admin o mlopez" autofocus />
                                    </div>
                                    <span asp-validation-for="UserName" class="text-danger small"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label small fw-semibold text-secondary"></label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-light border-end-0 text-muted">
                                            <i class="bi bi-key"></i>
                                        </span>
                                        <input asp-for="Password" type="password" class="form-control bg-light border-start-0 border-end-0 ps-0" id="passwordInput" placeholder="••••••••" />
                                        <button class="btn btn-light border border-start-0 text-muted" type="button" id="togglePasswordBtn">
                                            <i class="bi bi-eye" id="toggleIcon"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="Password" class="text-danger small"></span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input asp-for="RememberMe" class="form-check-input check-madero" type="checkbox" id="rememberMeCheck" />
                                        <label asp-for="RememberMe" class="form-check-label small text-secondary" for="rememberMeCheck">
                                            Recordar mi sesión
                                        </label>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-madero w-100 py-2 fw-semibold rounded-3 d-flex align-items-center justify-content-center gap-2 shadow-sm">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    <span>Entrar al sistema</span>
                                </button>
                            </form>

                            <div class="mt-4 pt-3 border-top text-center text-muted small">
                                <span class="d-block">&copy; 2026 El Viejo Madero</span>
                                <span class="d-block">Todos los derechos reservados</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Toggle ver/ocultar contraseña
        document.getElementById('togglePasswordBtn')?.addEventListener('click', function () {
            const passInput = document.getElementById('passwordInput');
            const icon = document.getElementById('toggleIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                passInput.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        });
    </script>
</body>
</html>
