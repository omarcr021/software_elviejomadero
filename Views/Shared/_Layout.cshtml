@using Microsoft.AspNetCore.Identity
@inject UserManager<software_elviejomadero.Models.ApplicationUser> UserManager
@{
    string currentUserFullName = "";
    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var appUser = await UserManager.GetUserAsync(User);
        if (appUser != null && !User.IsInRole("Administrador"))
        {
            currentUserFullName = appUser.FullName;
        }
    }
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - El Viejo Madero</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Inter (Sans-serif UI) + Georgia (Serif Headings) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-vm-cream">
    <header>
        <nav class="vm-topbar">
            <div class="vm-topbar-inner">
                <a class="vm-topbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="vm-logo-badge">VM</span>
                    <div class="vm-brand-info">
                        <span class="vm-brand-title">El Viejo Madero</span>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <span class="vm-brand-role">
                                @(User.IsInRole("Administrador") ? "Administrador" :
                                  User.IsInRole("Mozo") ? "Mozo" :
                                  User.IsInRole("Cocinero") ? "Cocinero" :
                                  User.IsInRole("Recepcionista") ? "Recepcionista" :
                                  User.IsInRole("Repartidor") ? "Repartidor" : "Colaborador") &middot; @currentUserFullName
                            </span>
                        }
                    </div>
                </a>

                <div class="vm-topbar-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Mozo") || User.IsInRole("Administrador"))
                        {
                            <a class="vm-topbar-nav-link" asp-controller="SalonOrder" asp-action="Index">Salón</a>
                        }
                        @if (User.IsInRole("Recepcionista") || User.IsInRole("Administrador"))
                        {
                            <a class="vm-topbar-nav-link" asp-controller="ReceptionOrder" asp-action="Index">Recepción</a>
                        }
                        @if (User.IsInRole("Cocinero") || User.IsInRole("Administrador"))
                        {
                            <a class="vm-topbar-nav-link" asp-controller="KitchenDispatch" asp-action="Index">Cocina</a>
                        }
                        @if (User.IsInRole("Repartidor") || User.IsInRole("Administrador"))
                        {
                            <a class="vm-topbar-nav-link" asp-controller="DeliveryRoute" asp-action="Index">Reparto</a>
                        }
                    }
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="vm-logout-link">
                                <i class="bi bi-box-arrow-right me-1"></i> Salir
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="vm-logout-link text-decoration-none" asp-controller="Account" asp-action="Login">
                            Iniciar sesión
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-4">
        <div class="vm-main-container">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
