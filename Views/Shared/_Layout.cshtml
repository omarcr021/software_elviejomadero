<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - El Viejo Madero</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts: Inter & Playfair Display -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-app">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-madero shadow-sm py-2">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-madero-light" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge"><i class="bi bi-fire"></i></span>
                    <span>El Viejo Madero</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                        aria-controls="navbarMain" aria-expanded="false" aria-label="Navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Administration" ? "active" : "")" 
                                       asp-controller="Administration" asp-action="Index">
                                        <i class="bi bi-speedometer2 me-1"></i> Administración
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dish" ? "active" : "")" 
                                       asp-controller="Dish" asp-action="Index">
                                        <i class="bi bi-journal-text me-1"></i> Carta
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Employee" ? "active" : "")" 
                                       asp-controller="Employee" asp-action="Index">
                                        <i class="bi bi-people me-1"></i> Empleados
                                    </a>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-house me-1"></i> Inicio
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <div class="user-profile-badge d-flex align-items-center gap-2 text-light">
                                <div class="avatar-circle">
                                    @(User.Identity.Name?.Substring(0, 1).ToUpper() ?? "U")
                                </div>
                                <div class="d-none d-sm-block text-start leading-tight">
                                    <div class="small fw-semibold text-white">@User.Identity.Name</div>
                                    <div class="text-role-badge">
                                        @(User.IsInRole("Administrador") ? "Administrador" :
                                          User.IsInRole("Mozo") ? "Mozo" :
                                          User.IsInRole("Cocinero") ? "Cocinero" :
                                          User.IsInRole("Recepcionista") ? "Recepcionista" :
                                          User.IsInRole("Repartidor") ? "Repartidor" : "Colaborador")
                                    </div>
                                </div>
                            </div>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3" title="Cerrar sesión">
                                    <i class="bi bi-box-arrow-right me-1"></i> Salir
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-madero-accent btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-person me-1"></i> Iniciar sesión
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-4">
        <div class="container-fluid px-lg-4">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <footer class="footer mt-auto py-3 bg-white border-top text-center text-muted small">
        <div class="container">
            <span>&copy; 2026 - <strong>El Viejo Madero</strong> &bull; Sistema de Gestión de Comandas y Delivery. Todos los derechos reservados.</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
