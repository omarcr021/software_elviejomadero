@model List<software_elviejomadero.Models.Order>
@using software_elviejomadero.Models
@{
    ViewData["Title"] = "Pedidos en cocina";
}
<div class="vm-admin-wrapper">
    <div class="vm-admin-header"><div><h1 class="vm-page-title"><i class="bi bi-fire me-2"></i>Pedidos en cocina</h1>
        <p class="vm-page-subtitle">Pedidos del salón enviados a cocina y deliveries pendientes de despacho.</p></div>
        <a asp-action="Index" class="vm-btn-outline-action text-decoration-none">Actualizar</a>
    </div>
    @if (!Model.Any()) { <div class="vm-empty-box">No hay pedidos pendientes en cocina.</div> }
    @foreach (var order in Model)
    {
        <article class="vm-dispatch-card">
            <div class="vm-dispatch-heading"><strong>@order.OrderCode</strong><span class="vm-route-badge">@order.OrderType</span><span>@order.Status</span></div>
            <p>
                @order.CustomerName
                @if (order.Table != null)
                {
                    <span>· Mesa @order.Table.Number</span>
                }
            </p>
            <ul class="mb-3">
                @foreach (var item in order.Items)
                {
                    <li>@item.Quantity × @item.DishName</li>
                }
            </ul>
            @if (order.OrderType == OrderTypes.Delivery && order.Status == OrderStatuses.New)
            {
                <form asp-action="Ready" asp-route-id="@order.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="vm-btn-save">Marcar listo para despacho</button>
                </form>
            }
        </article>
    }
</div>
